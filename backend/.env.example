# Environment
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL in production on Render / Supabase / Neon, SQLite fallback for local)
DATABASE_URL=postgresql://user:password@hostname:5432/qentra_db

# Security & Secrets
JWT_SECRET=your_super_secret_jwt_key_generate_one_for_production

# Frontend URL for CORS (Comma-separated for multiple domains, e.g. Vercel deployment URL)
FRONTEND_URL=http://localhost:5173,https://your-qentra-frontend.vercel.app
